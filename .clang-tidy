Checks: >
  -*,
  bugprone-*,-bugprone-easily-swappable-parameters,-bugprone-exception-escape,
  performance-*,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-prefer-member-initializer,
  cppcoreguidelines-slicing,
  readability-braces-around-statements,
  readability-const-return-type,
  readability-container-size-empty,
  readability-redundant-smartptr-get,
  readability-math-missing-parentheses,
  readability-identifier-naming,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-nodiscard,
  clang-analyzer-*

WarningsAsErrors: ''
HeaderFilterRegex: '.*/markovkit/(include|src|examples)/.*'
ExcludeHeaderFilterRegex: '.*/(archive|build|numerics)/.*'

CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.MethodCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    # Matrix/operator parameters conventionally use A, B, C, L, or R.
    value: aNy_CasE
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.VariableIgnoredRegexp
    value: '^(k[A-Z].*|[A-Z][0-9]*)$'
